// ============================================================================
// Kusto Tool: Resource Health Check
// Purpose: Cross-resource health overview using Azure Resource Graph + metrics
// Setup: Builder > Agent Canvas > Create > Tool > Kusto Tool
// Connector: Log Analytics
// Parameters: timeRange (e.g., "1h")
// ============================================================================

// Tool Name: resource-health-check
// Description: Comprehensive resource health scan across all monitored resources.
//              Use for daily health checks or when investigating broad issues.

// Check for resources with recent alerts
AzureActivity
| where TimeGenerated > ago(##timeRange##)
| where CategoryValue == "Alert"
| summarize AlertCount = count(), LastAlert = max(TimeGenerated) by Resource, ResourceGroup, Level
| order by AlertCount desc
| take 30
| project
    Resource,
    ResourceGroup,
    AlertSeverity = Level,
    AlertCount,
    LastAlert,
    Status = case(
        Level == "Critical", "🔴 CRITICAL",
        Level == "Error", "🟠 ERROR",
        Level == "Warning", "🟡 WARNING",
        "🔵 INFO"
    )
